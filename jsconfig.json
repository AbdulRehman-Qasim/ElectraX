  "compilerOptions": {
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@app/*": ["./src/app/*"],
      "@components/*": ["./src/components/*"],
      "@images/*": ["./src/images/*"],
